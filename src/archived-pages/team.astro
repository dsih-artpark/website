              </div>
            </div>
          </div>
        )) : (
          <div class="col-span-full text-center py-12">
            <p class="text-gray-600 dark:text-gray-300">No current team members found.</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Alumni Team Members -->
  {alumniTeamMembers && alumniTeamMembers.length > 0 && (
    <section class="py-20 bg-gray-50 dark:bg-gray-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Alumni
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-300">
            Former team members who contributed to our mission
          </p>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-8">
          {alumniTeamMembers.map((member) => (
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow opacity-75">
              <div class="p-3 md:p-6 flex flex-col h-full">
                <div class="text-center flex-shrink-0">
                  {getTeamMemberOptimizedImage(member.data.avatar) ? (
                    <Image 
                      src={getTeamMemberOptimizedImage(member.data.avatar)} 
                      alt={member.data.name}
                      width={96}
                      height={96}
                      class="w-16 h-16 md:w-24 md:h-24 rounded-full mx-auto mb-2 md:mb-4 object-cover"
                    />
                  ) : (
                    <img 
                      src={getTeamMemberAvatar(member)} 
                      alt={member.data.name}
                      class="w-16 h-16 md:w-24 md:h-24 rounded-full mx-auto mb-2 md:mb-4 object-cover"
                    />
                  )}
                  <a href={`/team/${member.slug}`} class="text-sm md:text-xl font-semibold text-gray-900 dark:text-white mb-1 hover:text-primary-600 dark:hover:text-primary-400 transition-colors block min-h-[2rem] md:min-h-[3rem] flex items-center justify-center">
