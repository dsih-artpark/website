---
import Layout from '../layouts/Layout.astro';
import { getCurrentTeamMembers, getAlumniTeamMembers, getTeamMemberAvatar, getTeamMemberOptimizedImage } from '../utils/team';
import { Image } from 'astro:assets';
import websiteIcon from '../images/website.svg';

// Get team members data (sorted alphabetically)
const currentTeamMembers = await getCurrentTeamMembers();
const alumniTeamMembers = await getAlumniTeamMembers();
---

<Layout title="Meet the Team" description="Meet the talented individuals behind Health Initiatives @ ARTPARK">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary-50 to-blue-50 dark:from-gray-900 dark:to-gray-800 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
          Meet Our <span class="text-primary-600 dark:text-primary-400">Team</span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          We're a diverse group of passionate professionals working together to bridge the gap between research and policy.
        </p>
      </div>
    </div>
  </section>

  <!-- Current Team Members -->
  <section class="py-20 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Current Team
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          Our active team members driving innovation and research
        </p>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-8">
        {currentTeamMembers && currentTeamMembers.length > 0 ? currentTeamMembers.map((member) => (
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="p-3 md:p-6 flex flex-col h-full">
              <div class="text-center flex-shrink-0">
                {getTeamMemberOptimizedImage(member.data.avatar) ? (
                  <Image 
                    src={getTeamMemberOptimizedImage(member.data.avatar)} 
                    alt={member.data.name}
                    width={96}
                    height={96}
                    class="w-16 h-16 md:w-24 md:h-24 rounded-full mx-auto mb-2 md:mb-4 object-cover"
                  />
                ) : (
                  <img 
                    src={getTeamMemberAvatar(member)} 
                    alt={member.data.name}
                    class="w-16 h-16 md:w-24 md:h-24 rounded-full mx-auto mb-2 md:mb-4 object-cover"
                  />
                )}
                <a href={`/team/${member.slug}`} class="text-sm md:text-xl font-semibold text-gray-900 dark:text-white mb-1 hover:text-primary-600 dark:hover:text-primary-400 transition-colors block min-h-[2rem] md:min-h-[3rem] flex items-center justify-center">
                  {member.data.prefix ? `${member.data.prefix} ${member.data.name}` : member.data.name}
                </a>
                <p class="text-primary-600 dark:text-primary-400 font-medium mb-2 text-xs md:text-base min-h-[1.5rem] md:min-h-[2.5rem] flex items-center justify-center">
                  {member.data.role}
                </p>
                <div class="flex justify-center mb-2 md:mb-3">
                  <span class={`inline-flex items-center px-2 py-0.5 md:px-2.5 rounded-full text-xs font-medium ${
                    member.data.type === 'core' 
                      ? 'bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200'
                      : member.data.type === 'associated faculty'
                      ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'
                      : 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200'
                  }`}>
                    {member.data.type === 'core' ? 'Core Team' : 
                     member.data.type === 'associated faculty' ? 'Associated Faculty' : 'Advisor'}
                  </span>
                </div>
              </div>
              <div class="flex-grow flex flex-col justify-between hidden md:flex">
                <p class="text-gray-600 dark:text-gray-300 text-sm mb-4 text-center min-h-[3rem] flex items-center justify-center">
                  {member.data.bio}
                </p>
                
                <!-- Social Links -->
                <div class="flex justify-center space-x-3 hidden md:flex">
                  {member.data.socials.website && (
                    <a 
                      href={member.data.socials.website} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                      aria-label={`${member.data.name}'s Website`}
                    >
                      <Image src={websiteIcon} alt="Website" class="w-5 h-5" width={20} height={20} />
                    </a>
                  )}
                  
                  {member.data.socials.github && (
                    <a 
                      href={member.data.socials.github} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
                      aria-label={`${member.data.name}'s GitHub`}
                    >
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                      </svg>
                    </a>
                  )}
                  
                  {member.data.socials.twitter && (
                    <a 
                      href={member.data.socials.twitter} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="text-gray-400 hover:text-blue-400 transition-colors"
                      aria-label={`${member.data.name}'s Twitter`}
                    >
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                      </svg>
                    </a>
                  )}
                  
                  {member.data.socials.linkedin && (
                    <a 
                      href={member.data.socials.linkedin} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="text-gray-400 hover:text-blue-600 transition-colors"
                      aria-label={`${member.data.name}'s LinkedIn`}
                    >
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                      </svg>
                    </a>
                  )}
                  
                  {member.data.socials.email && (
                    <a 
                      href={`mailto:${member.data.socials.email}`}
                      class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
                      aria-label={`Email ${member.data.name}`}
                    >
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                    </a>
                  )}
                  
                  {member.data.socials.mastodon && (
                    <a 
