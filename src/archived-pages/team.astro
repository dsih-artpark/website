                    {member.data.role}
                  </p>
                  <div class="flex justify-center mb-2 md:mb-3">
                    <span class={`inline-flex items-center px-2 py-0.5 md:px-2.5 rounded-full text-xs font-medium ${
                      member.data.type === 'core' 
                        ? 'bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200'
                        : member.data.type === 'associated faculty'
                        ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'
                        : 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200'
                    }`}>
                      {member.data.type === 'core' ? 'Core Team' : 
                       member.data.type === 'associated faculty' ? 'Associated Faculty' : 'Advisor'}
                    </span>
