---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Get all media items from content collections
const mediaItems = await getCollection('media');

const getTypeColor = (type: string) => {
  switch (type) {
    case "Award":
      return "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200";
    case "Article":
      return "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200";
    case "Podcast":
      return "bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200";
    case "Video":
      return "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200";
    case "Conference":
      return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200";
    case "Report":
      return "bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200";
    default:
      return "bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200";
  }
};

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
};
---

<Layout title="Awards and Media - Health Initiatives @ ARTPARK" description="Explore awards, media coverage and recognition received by Health Initiatives @ ARTPARK across various publications and platforms">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary-50 to-blue-50 dark:from-gray-900 dark:to-gray-800 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
          Awards & <span class="text-primary-600 dark:text-primary-400">Media</span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Discover the awards, stories, interviews, and recognition that showcase our team's impact and innovation in the tech industry.
        </p>
      </div>
    </div>
  </section>

  <!-- Awards Section -->
  <section class="py-20 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Awards & Recognition</h2>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Celebrating our achievements and industry recognition for innovative solutions and outstanding contributions.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
        {mediaItems.filter(item => item.data.type === "Award").map((item) => (
          <article class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow flex flex-col h-full">
            <div class="relative">
              {item.data.image ? (
                <img 
                  src={item.data.image} 
                  alt={item.data.title}
                  class="w-full h-48 object-cover"
                />
              ) : (
                <div class="w-full h-48 bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-600 flex items-center justify-center">
                  <div class="text-center">
                    <svg class="w-12 h-12 text-gray-400 dark:text-gray-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                    <p class="text-xs text-gray-500 dark:text-gray-400 font-medium">{item.data.publication}</p>
                  </div>
                </div>
              )}
              <div class="absolute top-4 right-4">
                <span class={`px-3 py-1 rounded-full text-xs font-medium ${getTypeColor(item.data.type)}`}>
                  {item.data.type}
                </span>
              </div>
            </div>
            
            <div class="p-6 flex flex-col justify-between h-full">
              <div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                  {item.data.title}
                </h3>
                
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">
                  <span class="font-medium">{item.data.publication}</span>
                </p>
                
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">
                  {formatDate(item.data.date)}
                </p>
                
                <p class="text-sm text-gray-600 dark:text-gray-300">
                  {item.data.excerpt}
                </p>
              </div>
              
              <div class="mt-6">
                <a 
                  href={item.data.url} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="w-full bg-primary-600 hover:bg-primary-700 text-white text-center px-4 py-2 rounded text-sm font-medium transition-colors inline-flex items-center justify-center gap-2"
                >
                  Read More
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Media Coverage Section -->
  <section class="py-20 bg-gray-50 dark:bg-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Media Coverage</h2>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Featured articles, interviews, and coverage highlighting our work and impact across various publications and platforms.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
        {mediaItems.filter(item => item.data.type !== "Award").map((item) => (
          <article class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow flex flex-col h-full">
            <div class="relative">
              {item.data.image ? (
                <img 
                  src={item.data.image} 
                  alt={item.data.title}
                  class="w-full h-48 object-cover"
                />
              ) : (
                <div class="w-full h-48 bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-600 flex items-center justify-center">
                  <div class="text-center">
                    <svg class="w-12 h-12 text-gray-400 dark:text-gray-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                    <p class="text-xs text-gray-500 dark:text-gray-400 font-medium">{item.data.publication}</p>
                  </div>
                </div>
              )}
              <div class="absolute top-4 right-4">
                <span class={`px-3 py-1 rounded-full text-xs font-medium ${getTypeColor(item.data.type)}`}>
                  {item.data.type}
                </span>
              </div>
            </div>
            
            <div class="p-6 flex flex-col justify-between h-full">
              <div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                  {item.data.title}
                </h3>
                
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">
                  <span class="font-medium">{item.data.publication}</span>
                </p>
                
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">
                  {formatDate(item.data.date)}
                </p>
                
                <p class="text-sm text-gray-600 dark:text-gray-300">
                  {item.data.excerpt}
                </p>
              </div>
              
              <div class="mt-6">
                <a 
                  href={item.data.url} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="w-full bg-primary-600 hover:bg-primary-700 text-white text-center px-4 py-2 rounded text-sm font-medium transition-colors inline-flex items-center justify-center gap-2"
                >
                  Read More
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-20 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Our Impact in Numbers
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-300">
          The recognition and coverage we've received across various platforms
        </p>
      </div>
      
      <div class="grid md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-4xl font-bold text-primary-600 dark:text-primary-400 mb-2">
            {mediaItems.length}
          </div>
          <div class="text-gray-600 dark:text-gray-300">Media Mentions</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-primary-600 dark:text-primary-400 mb-2">
            {new Set(mediaItems.map(item => item.data.publication)).size}
          </div>
          <div class="text-gray-600 dark:text-gray-300">Publications</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-primary-600 dark:text-primary-400 mb-2">
            {new Set(mediaItems.map(item => item.data.project)).size}
          </div>
          <div class="text-gray-600 dark:text-gray-300">Projects Featured</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-primary-600 dark:text-primary-400 mb-2">
            {mediaItems.filter(item => item.data.type === 'Award').length}
          </div>
          <div class="text-gray-600 dark:text-gray-300">Awards Won</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-primary-600 dark:bg-primary-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Want to Feature Our Work?
      </h2>
      <p class="text-xl text-primary-100 mb-8 max-w-2xl mx-auto">
        We're always excited to share our story and insights. Get in touch for interviews, collaborations, or media inquiries.
      </p>
      <a href="mailto:media@dsih-team.com" class="bg-white text-primary-600 hover:bg-gray-100 px-8 py-3 rounded-lg font-medium transition-colors">
        Contact Media Team
      </a>
    </div>
  </section>
</Layout>