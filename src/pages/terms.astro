---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms of Service - Health Initiatives @ ARTPARK" description="Terms of Service for Health Initiatives @ ARTPARK website and services.">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary-50 to-blue-50 dark:from-gray-900 dark:to-gray-800 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
          Terms of <span class="text-primary-600 dark:text-primary-400">Service</span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Terms and conditions for using our website and services.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-20 bg-white dark:bg-gray-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg dark:prose-invert max-w-none">
