                <div class="flex items-center gap-1">
                  Tags
                  <svg class="w-3 h-3 sort-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                  </svg>
                </div>
              </th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide w-20">Details</th>
            </tr>
          </thead>
          <tbody>
            {processedDatasets.map((dataset, index) => (
              <>
              <tr class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer transition-colors duration-200" 
                  data-index={index} 
                  data-toggle-index={index}
                  data-category={dataset.category}
                  data-collection={dataset.collection}
                  data-tags={dataset.tags}
                  data-title={(dataset.title || '').toLowerCase()}
                  data-description={(dataset.description || '').toLowerCase()}>
                <!-- ID Column -->
                  <td class="px-6 py-4">
                  <span class="text-sm font-mono text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded font-medium">
                    {dataset.id}
                  </span>
                </td>
                
                <!-- Category Column -->
                  <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                    {dataset.category}
                  </span>
                </td>
                
                <!-- Title Column -->
                  <td class="px-6 py-4">
                  <h3 class="text-sm font-semibold text-gray-900 dark:text-white" title={dataset.title}>
                    {dataset.title}
                  </h3>
                </td>
                
                <!-- Collection Column -->
                <td class="px-6 py-4">
                  <p class="text-xs text-gray-600 dark:text-gray-400 break-words" title={dataset.collection}>
                    {dataset.collection}
                  </p>
                </td>
                
                <!-- Tags Column -->
                  <td class="px-6 py-4">
                  {dataset.tags && (
                    <div class="flex flex-wrap gap-1">
                      {dataset.tags.split(', ').slice(0, 2).map(tag => (
                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200">
                          {tag}
                        </span>
                      ))}
                      {dataset.tags.split(', ').length > 2 && (
                        <span class="text-xs text-gray-500 dark:text-gray-400">+{dataset.tags.split(', ').length - 2}</span>
                      )}
                    </div>
                  )}
                </td>
                
                  <!-- Details Toggle Column -->
                  <td class="px-6 py-4 text-center">
                    <div class="flex justify-center items-center">
                      <svg class="w-5 h-5 text-gray-400 transform transition-transform" id={`chevron-${index}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </div>
                  </td>
              </tr>
              
              <!-- Collapsible Details Row -->
                <tr class="hidden" id={`details-${index}`}>
                  <td colspan="6" class="px-6 py-4 bg-gray-50 dark:bg-gray-700 border-b border-gray-200 dark:border-gray-600">
                    <div class="space-y-4 text-sm">
                      <div class="w-full">
                        <span class="font-medium text-gray-700 dark:text-gray-300">Description:</span>
                        <p class="text-gray-600 dark:text-gray-400 mt-1 break-words overflow-wrap-anywhere hyphens-auto whitespace-normal w-full">{dataset.description}</p>
                      </div>
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                          <span class="font-medium text-gray-700 dark:text-gray-300">Data Owner:</span>
                          <p class="text-gray-600 dark:text-gray-400 mt-1">{dataset.dataOwner}</p>
                        </div>
                        <div>
                          <span class="font-medium text-gray-700 dark:text-gray-300">Source:</span>
                          <p class="text-gray-600 dark:text-gray-400 mt-1">{dataset.source}</p>
                        </div>
                      </div>
                      {dataset.tags && (
                        <div>
                          <span class="font-medium text-gray-700 dark:text-gray-300">All Tags:</span>
                          <div class="flex flex-wrap gap-1 mt-1">
                            {dataset.tags.split(', ').map(tag => (
                              <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200">
                                {tag}
                              </span>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                </td>
              </tr>
              </>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile Table -->
      <div id="mobile-table-container" class="md:hidden space-y-4">
        {processedDatasets.map((dataset, index) => (
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden"
               data-category={dataset.category}
               data-collection={dataset.collection}
               data-tags={dataset.tags}
               data-title={(dataset.title || '').toLowerCase()}
               data-description={(dataset.description || '').toLowerCase()}>
            <!-- Main Row -->
            <div class="p-4 border-b border-gray-200 dark:border-gray-700" data-mobile-index={index} data-mobile-toggle-index={index}>
              <div class="flex items-start justify-between mb-3">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-3 mb-2">
                    <!-- ID -->
                    <span class="text-xs font-mono text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded font-medium flex-shrink-0">
                      {dataset.id}
                    </span>
                    <!-- Category -->
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200 flex-shrink-0">
                      {dataset.category}
                    </span>
                  </div>
                  <!-- Title -->
                  <h3 class="text-sm font-semibold text-gray-900 dark:text-white leading-tight">
                    {dataset.title}
                  </h3>
                </div>
                <!-- Chevron -->
                <div class="ml-3 flex-shrink-0 cursor-pointer" data-mobile-toggle-index={index}>
                  <svg class="w-5 h-5 text-gray-400 transform transition-transform" id={`mobile-chevron-${index}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </div>
              </div>
            </div>
            
            <!-- Collapsible Details -->
            <div class="hidden" id={`mobile-details-${index}`}>
              <div class="p-4 bg-gray-50 dark:bg-gray-700 space-y-4 text-sm">
                <!-- Description -->
                <div>
                  <span class="font-medium text-gray-700 dark:text-gray-300">Description:</span>
                  <p class="text-gray-600 dark:text-gray-400 mt-1 break-words">{dataset.description}</p>
                </div>
                
                <!-- Collection -->
                <div>
                  <span class="font-medium text-gray-700 dark:text-gray-300">Collection:</span>
                  <p class="text-gray-600 dark:text-gray-400 mt-1">{dataset.collection}</p>
                </div>
                
                <!-- Data Owner and Source -->
                <div class="grid grid-cols-1 gap-3">
                  <div>
                    <span class="font-medium text-gray-700 dark:text-gray-300">Data Owner:</span>
                    <p class="text-gray-600 dark:text-gray-400 mt-1">{dataset.dataOwner}</p>
                  </div>
                  <div>
                    <span class="font-medium text-gray-700 dark:text-gray-300">Source:</span>
                    <p class="text-gray-600 dark:text-gray-400 mt-1">{dataset.source}</p>
                  </div>
                </div>
                
                <!-- Tags -->
                {dataset.tags && (
                  <div>
                    <span class="font-medium text-gray-700 dark:text-gray-300">Tags:</span>
                    <div class="flex flex-wrap gap-1 mt-1">
                      {dataset.tags.split(', ').map(tag => (
                        <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-600 dark:text-gray-200">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
                
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Results count -->
      <div class="mt-6 text-sm text-gray-600 dark:text-gray-400">
        <span id="resultsCount">Showing {processedDatasets.length} datasets</span>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Global state for filters and sorting
  let selectedTags: string[] = [];
  let currentFilters = {
    search: '',
    category: '',
    collection: '',
    tags: [] as string[]
  };
  let currentSort = {
    column: '',
    direction: 'asc' as 'asc' | 'desc'
  };

  // Function to toggle details visibility for desktop
  function toggleDetails(index: number) {
    const detailsElement = document.getElementById(`details-${index}`);
    const chevronElement = document.getElementById(`chevron-${index}`);
    
    if (detailsElement && chevronElement) {
      const isHidden = detailsElement.classList.contains('hidden');
      
      // Close all other open desktop details first
      const allDesktopDetails = document.querySelectorAll('[id^="details-"]');
      const allDesktopChevrons = document.querySelectorAll('[id^="chevron-"]');
      
      allDesktopDetails.forEach((element, i) => {
        if (i !== index) {
          element.classList.add('hidden');
        }
      });
      
      allDesktopChevrons.forEach((element, i) => {
        if (i !== index) {
          (element as HTMLElement).style.transform = 'rotate(0deg)';
        }
      });
      
      // Close all mobile details as well
      const allMobileDetails = document.querySelectorAll('[id^="mobile-details-"]');
      const allMobileChevrons = document.querySelectorAll('[id^="mobile-chevron-"]');
      
      allMobileDetails.forEach(element => {
        element.classList.add('hidden');
      });
      
      allMobileChevrons.forEach(element => {
        (element as HTMLElement).style.transform = 'rotate(0deg)';
      });
      
      // Now toggle the selected desktop detail
      if (isHidden) {
        detailsElement.classList.remove('hidden');
        chevronElement.style.transform = 'rotate(180deg)';
      } else {
        detailsElement.classList.add('hidden');
        chevronElement.style.transform = 'rotate(0deg)';
      }
    }
  }

  // Function to toggle mobile details visibility
  function toggleMobileDetails(index: number) {
    const detailsElement = document.getElementById(`mobile-details-${index}`);
    const chevronElement = document.getElementById(`mobile-chevron-${index}`);
    
    if (detailsElement && chevronElement) {
      const isHidden = detailsElement.classList.contains('hidden');
      
      // Close all other open mobile details first
      const allMobileDetails = document.querySelectorAll('[id^="mobile-details-"]');
      const allMobileChevrons = document.querySelectorAll('[id^="mobile-chevron-"]');
      
      allMobileDetails.forEach((element, i) => {
        if (i !== index) {
          element.classList.add('hidden');
        }
      });
      
      allMobileChevrons.forEach((element, i) => {
        if (i !== index) {
          (element as HTMLElement).style.transform = 'rotate(0deg)';
        }
      });
      
      // Close all desktop details as well
      const allDesktopDetails = document.querySelectorAll('[id^="details-"]');
      const allDesktopChevrons = document.querySelectorAll('[id^="chevron-"]');
      
      allDesktopDetails.forEach(element => {
        element.classList.add('hidden');
      });
      
      allDesktopChevrons.forEach(element => {
        (element as HTMLElement).style.transform = 'rotate(0deg)';
      });
      
      // Now toggle the selected mobile detail
      if (isHidden) {
        detailsElement.classList.remove('hidden');
        chevronElement.style.transform = 'rotate(180deg)';
      } else {
        detailsElement.classList.add('hidden');
        chevronElement.style.transform = 'rotate(0deg)';
      }
    }
  }

  // Function to sort data
  function sortData(column: string) {
    const tbody = document.querySelector('table tbody');
    if (!tbody) return;

    const rows = Array.from(tbody.querySelectorAll('tr[data-index]'));
    
    // Determine sort direction
    if (currentSort.column === column) {
      currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
    } else {
      currentSort.column = column;
      currentSort.direction = 'asc';
    }

    // Update sort icons
    document.querySelectorAll('.sort-icon').forEach(icon => {
      (icon as HTMLElement).style.transform = 'rotate(0deg)';
      (icon as HTMLElement).style.opacity = '0.5';
    });

    const currentHeader = document.querySelector(`th[data-sort="${column}"] .sort-icon`);
    if (currentHeader) {
      (currentHeader as HTMLElement).style.opacity = '1';
      (currentHeader as HTMLElement).style.transform = currentSort.direction === 'asc' ? 'rotate(180deg)' : 'rotate(0deg)';
    }

    // Sort rows
    rows.sort((a, b) => {
      let aValue = '';
      let bValue = '';

      switch (column) {
        case 'id':
          aValue = a.getAttribute('data-index') || '';
          bValue = b.getAttribute('data-index') || '';
          // Sort numerically for ID
          return currentSort.direction === 'asc' 
            ? parseInt(aValue) - parseInt(bValue)
            : parseInt(bValue) - parseInt(aValue);
        case 'category':
          aValue = a.getAttribute('data-category') || '';
          bValue = b.getAttribute('data-category') || '';
          break;
        case 'title':
          aValue = a.getAttribute('data-title') || '';
          bValue = b.getAttribute('data-title') || '';
          break;
        case 'collection':
          aValue = a.getAttribute('data-collection') || '';
          bValue = b.getAttribute('data-collection') || '';
          break;
        case 'tags':
          aValue = a.getAttribute('data-tags') || '';
          bValue = b.getAttribute('data-tags') || '';
          break;
        default:
          return 0;
      }

      if (currentSort.direction === 'asc') {
        return aValue.localeCompare(bValue);
      } else {
        return bValue.localeCompare(aValue);
      }
    });

    // Re-append sorted rows
    rows.forEach(row => tbody.appendChild(row));
  }

  // Function to apply filters
  function applyFilters() {
    // Close all open toggles first
    const allDesktopDetails = document.querySelectorAll('[id^="details-"]');
    const allDesktopChevrons = document.querySelectorAll('[id^="chevron-"]');
    const allMobileDetails = document.querySelectorAll('[id^="mobile-details-"]');
    const allMobileChevrons = document.querySelectorAll('[id^="mobile-chevron-"]');
    
    allDesktopDetails.forEach(element => {
      element.classList.add('hidden');
    });
    
    allDesktopChevrons.forEach(element => {
      (element as HTMLElement).style.transform = 'rotate(0deg)';
    });
    
    allMobileDetails.forEach(element => {
      element.classList.add('hidden');
    });
    
    allMobileChevrons.forEach(element => {
      (element as HTMLElement).style.transform = 'rotate(0deg)';
    });

    const desktopRows = document.querySelectorAll('tbody tr[data-category]');
    const mobileCards = document.querySelectorAll('#mobile-table-container > div[data-category]');
    let visibleCount = 0;

    // Filter desktop rows
    desktopRows.forEach((row: Element) => {
      const element = row as HTMLElement;
      const category = element.getAttribute('data-category') || '';
      const collection = element.getAttribute('data-collection') || '';
      const tags = element.getAttribute('data-tags') || '';
      const title = element.getAttribute('data-title') || '';
      const description = element.getAttribute('data-description') || '';

      const matchesSearch = !currentFilters.search || 
        title.includes(currentFilters.search.toLowerCase()) ||
        description.includes(currentFilters.search.toLowerCase());

      const matchesCategory = !currentFilters.category || category === currentFilters.category;
      const matchesCollection = !currentFilters.collection || collection === currentFilters.collection;
      
      const matchesTags = currentFilters.tags.length === 0 || 
        currentFilters.tags.some(tag => tags.includes(tag));

      if (matchesSearch && matchesCategory && matchesCollection && matchesTags) {
        element.style.display = '';
        visibleCount++;
      } else {
        element.style.display = 'none';
      }
    });

    // Filter mobile cards
    mobileCards.forEach((card: Element) => {
      const element = card as HTMLElement;
      const category = element.getAttribute('data-category') || '';
      const collection = element.getAttribute('data-collection') || '';
      const tags = element.getAttribute('data-tags') || '';
      const title = element.getAttribute('data-title') || '';
      const description = element.getAttribute('data-description') || '';

      const matchesSearch = !currentFilters.search || 
        title.includes(currentFilters.search.toLowerCase()) ||
        description.includes(currentFilters.search.toLowerCase());

      const matchesCategory = !currentFilters.category || category === currentFilters.category;
      const matchesCollection = !currentFilters.collection || collection === currentFilters.collection;
      
      const matchesTags = currentFilters.tags.length === 0 || 
        currentFilters.tags.some(tag => tags.includes(tag));

      if (matchesSearch && matchesCategory && matchesCollection && matchesTags) {
        element.style.display = '';
      } else {
        element.style.display = 'none';
      }
    });

    // Update results count
    const resultsCount = document.getElementById('resultsCount');
    if (resultsCount) {
      resultsCount.textContent = `Showing ${visibleCount} datasets`;
    }
  }

  // Function to toggle tag selection
  function toggleTag(tag: string, button: HTMLElement) {
    const isSelected = selectedTags.includes(tag);
    
    if (isSelected) {
      selectedTags = selectedTags.filter(t => t !== tag);
      button.classList.remove('bg-primary-600', 'text-white', 'border-primary-600', 'hover:bg-primary-700');
      button.classList.add('bg-white', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300', 'border-gray-300', 'dark:border-gray-600', 'hover:bg-gray-50', 'dark:hover:bg-gray-600', 'hover:text-gray-800', 'dark:hover:text-gray-200');
    } else {
      selectedTags.push(tag);
      button.classList.add('bg-primary-600', 'text-white', 'border-primary-600', 'hover:bg-primary-700');
      button.classList.remove('bg-white', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300', 'border-gray-300', 'dark:border-gray-600', 'hover:bg-gray-50', 'dark:hover:bg-gray-600', 'hover:text-gray-800', 'dark:hover:text-gray-200');
    }
    
    currentFilters.tags = selectedTags;
    applyFilters();
  }

  // Function to reset all filters
  function resetFilters() {
    // Reset filter state
    currentFilters = {
      search: '',
      category: '',
      collection: '',
      tags: []
    };
    selectedTags = [];

    // Reset search inputs
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const mobileSearchInput = document.getElementById('mobileSearchInput') as HTMLInputElement;
    if (searchInput) searchInput.value = '';
    if (mobileSearchInput) mobileSearchInput.value = '';

    // Reset dropdowns
    const categoryFilter = document.getElementById('categoryFilter') as HTMLSelectElement;
    const mobileCategoryFilter = document.getElementById('mobileCategoryFilter') as HTMLSelectElement;
    const collectionFilter = document.getElementById('collectionFilter') as HTMLSelectElement;
    const mobileCollectionFilter = document.getElementById('mobileCollectionFilter') as HTMLSelectElement;
    
    if (categoryFilter) categoryFilter.value = '';
    if (mobileCategoryFilter) mobileCategoryFilter.value = '';
    if (collectionFilter) collectionFilter.value = '';
    if (mobileCollectionFilter) mobileCollectionFilter.value = '';

    // Reset tag buttons
    const tagButtons = document.querySelectorAll('.tag-filter-btn');
    tagButtons.forEach(button => {
      const element = button as HTMLElement;
      element.classList.remove('bg-primary-600', 'text-white', 'border-primary-600', 'hover:bg-primary-700');
      element.classList.add('bg-white', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300', 'border-gray-300', 'dark:border-gray-600', 'hover:bg-gray-50', 'dark:hover:bg-gray-600', 'hover:text-gray-800', 'dark:hover:text-gray-200');
    });

    // Apply filters (show all)
    applyFilters();
  }
  
  // Add event delegation for row clicks and filters
  document.addEventListener('DOMContentLoaded', function() {
    // Desktop table event delegation
    const table = document.querySelector('table tbody');
    
    if (table) {
      table.addEventListener('click', function(e) {
        const target = e.target as HTMLElement;
        
        if (target) {
          // Find the closest row with data-toggle-index
          const row = target.closest('[data-toggle-index]') as HTMLElement;
          
          if (row && !target.closest('button')) {
            const index = parseInt(row.getAttribute('data-toggle-index') || '0');
            toggleDetails(index);
          }
        }
      });
    }

    // Mobile table event delegation
    const mobileContainer = document.getElementById('mobile-table-container');
    
    if (mobileContainer) {
      mobileContainer.addEventListener('click', function(e) {
        const target = e.target as HTMLElement;
        
        if (target) {
          // Find the closest row with data-mobile-toggle-index
          const row = target.closest('[data-mobile-toggle-index]') as HTMLElement;
          
          if (row && !target.closest('button')) {
            const index = parseInt(row.getAttribute('data-mobile-toggle-index') || '0');
            toggleMobileDetails(index);
          }
        }
      });
    }

    // Search input events
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const mobileSearchInput = document.getElementById('mobileSearchInput') as HTMLInputElement;
    
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        currentFilters.search = this.value;
        applyFilters();
      });
    }
    
    if (mobileSearchInput) {
      mobileSearchInput.addEventListener('input', function() {
        currentFilters.search = this.value;
        applyFilters();
      });
    }

    // Category filter events
    const categoryFilter = document.getElementById('categoryFilter') as HTMLSelectElement;
    const mobileCategoryFilter = document.getElementById('mobileCategoryFilter') as HTMLSelectElement;
    
    if (categoryFilter) {
      categoryFilter.addEventListener('change', function() {
        currentFilters.category = this.value;
        applyFilters();
      });
    }
    
    if (mobileCategoryFilter) {
      mobileCategoryFilter.addEventListener('change', function() {
        currentFilters.category = this.value;
        applyFilters();
      });
    }

    // Collection filter events
    const collectionFilter = document.getElementById('collectionFilter') as HTMLSelectElement;
    const mobileCollectionFilter = document.getElementById('mobileCollectionFilter') as HTMLSelectElement;
    
    if (collectionFilter) {
      collectionFilter.addEventListener('change', function() {
        currentFilters.collection = this.value;
        applyFilters();
      });
    }
    
    if (mobileCollectionFilter) {
      mobileCollectionFilter.addEventListener('change', function() {
        currentFilters.collection = this.value;
        applyFilters();
      });
    }

    // Tag filter events
    const tagButtons = document.querySelectorAll('.tag-filter-btn');
    tagButtons.forEach(button => {
      button.addEventListener('click', function(this: HTMLElement) {
        const tag = this.getAttribute('data-tag') || '';
        toggleTag(tag, this);
      });
    });

    // Reset filters button event
    const resetFiltersBtn = document.getElementById('resetFiltersBtn');
    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener('click', resetFilters);
    }

    // Sort functionality
    const sortHeaders = document.querySelectorAll('th[data-sort]');
    sortHeaders.forEach(header => {
      header.addEventListener('click', function(this: HTMLElement) {
        const column = this.getAttribute('data-sort');
        if (column) {
          sortData(column);
        }
      });
    });
  });
</script>
