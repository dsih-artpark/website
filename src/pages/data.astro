---
import Layout from '../layouts/Layout.astro';
import datasets from '../data/datasets.json';

// Process datasets for the table
const processedDatasets = datasets.map(dataset => {
  // Extract 4-digit numeric ID from ds_id
  const idMatch = dataset.ds_id.match(/(\d{4})$/);
  const numericId = idMatch ? idMatch[1] : '';
  
  // Extract source from raw_datasets
  const source = dataset.raw_datasets && dataset.raw_datasets.length > 0 
    ? dataset.raw_datasets[0].source 
    : '';
  
  // Format tags
  const tags = dataset.tags ? dataset.tags.map(tag => tag.tag_name).join(', ') : '';

  let accessLevel = '';
  if (dataset.access_level === 'DOWNLOAD') {
    accessLevel = 'Public';
  } else if (dataset.access_level === 'VIEW') {
    accessLevel = 'Restricted';
  }
  
  return {
    title: dataset.title || '',
    id: numericId,
    description: dataset.description || '',
    dataOwner: dataset.data_owner?.name || '',
    source: source,
    category: dataset.collection?.category_name || '',
    collection: dataset.collection?.collection_name || '',
    tags: tags,
    accessLevel: accessLevel,
    downloadLink: '' // Empty for now
  };
});
---

<Layout title="Data Catalogue - Health Initiatives @ ARTPARK" description="Access our datasets and data resources for health research and innovation.">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary-50 to-blue-50 dark:from-gray-900 dark:to-gray-800 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
          <span class="text-primary-600 dark:text-primary-400">Data Catalogue</span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Browse our data catalogue and access datasets that we've collated and standardised.
        </p>
      </div>
    </div>
  </section>

  <!-- Filters Section -->
  <section class="py-8 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Desktop Filters -->
      <div class="hidden md:block">
        <div class="flex items-center justify-between gap-4 mb-6">
          <!-- Left side: Dropdowns -->
          <div class="flex items-center gap-4">
            <!-- Category Dropdown -->
            <div class="relative">
              <select id="categoryFilter" class="appearance-none bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-2 pr-8 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
                <option value="">All Categories</option>
                {Array.from(new Set(processedDatasets.map(d => d.category))).map(category => (
                  <option value={category}>{category}</option>
                ))}
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>
            
            <!-- Collection Dropdown -->
            <div class="relative">
              <select id="collectionFilter" class="appearance-none bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-2 pr-8 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
                <option value="">All Collections</option>
                {Array.from(new Set(processedDatasets.map(d => d.collection))).map(collection => (
                  <option value={collection}>{collection}</option>
                ))}
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>
          </div>
          
          <!-- Right side: Search -->
          <div class="relative">
            <input 
              type="text" 
              id="searchInput" 
              placeholder="Search datasets..." 
              class="w-64 pl-10 pr-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
            <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Mobile Filters -->
      <div class="md:hidden space-y-4">
        <!-- Search Bar -->
        <div class="flex justify-center">
          <div class="relative w-full max-w-sm">
            <input 
              type="text" 
              id="mobileSearchInput" 
              placeholder="Search datasets..." 
              class="w-full pl-10 pr-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            >
            <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
          </div>
        </div>
        
        <!-- Dropdowns -->
        <div class="flex flex-col sm:flex-row gap-3">
          <!-- Category Dropdown -->
          <div class="relative flex-1">
            <select id="mobileCategoryFilter" class="w-full appearance-none bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-2 pr-8 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
              <option value="">All Categories</option>
              {Array.from(new Set(processedDatasets.map(d => d.category))).map(category => (
                <option value={category}>{category}</option>
              ))}
            </select>
            <div class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>
          
          <!-- Collection Dropdown -->
          <div class="relative flex-1">
            <select id="mobileCollectionFilter" class="w-full appearance-none bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-2 pr-8 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
              <option value="">All Collections</option>
              {Array.from(new Set(processedDatasets.map(d => d.collection))).map(collection => (
                <option value={collection}>{collection}</option>
              ))}
            </select>
            <div class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Tag Filters -->
      <div class="mt-6">
        <div class="flex items-center gap-2 mb-3">
          <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
          </svg>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Filter by tags:</span>
        </div>
        <div class="flex flex-wrap gap-2" id="tagFilters">
          {Array.from(new Set(processedDatasets.flatMap(d => d.tags ? d.tags.split(', ') : []))).map(tag => (
            <button 
              class="tag-filter-btn inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600 hover:text-gray-800 dark:hover:text-gray-200 transition-colors duration-200"
              data-tag={tag}
            >
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              {tag}
            </button>
          ))}
        </div>
        
        <!-- Reset Filters Button -->
        <div class="mt-4 flex justify-end">
          <button 
            id="resetFiltersBtn"
            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200 transition-colors duration-200"
          >
