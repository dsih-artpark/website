                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                  </svg>
                </div>
              </th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide w-32 cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors" data-sort="category">
                <div class="flex items-center gap-1">
