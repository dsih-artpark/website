---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import bhaskarSpeaking from '../images/bhaskar-speaking.jpg';
import rohitPmac from '../images/rohit-pmac.jpg';
import harishTalk from '../images/harish-talk.jpg';
import hmPrismhLaunch from '../images/hm-prismh-launch.jpg';
import teamAllHands from '../images/team-all-hands.jpg';
---

<style>
  .word-container {
    display: inline-block;
    min-width: 150px;
    text-align: center;
    position: relative;
  }
  
  @media (min-width: 640px) {
    .word-container {
      min-width: 300px;
      text-align: left;
    }
  }

  .typewriter-word {
    color: #3b82f6; /* default blue */
    border-right: 2px solid #3b82f6;
    animation: blink 1s infinite;
    position: relative;
    display: inline-block;
  }

  .typewriter-word::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 0;
    height: 3px;
    background: linear-gradient(90deg, 
      rgba(0,0,0,0.3) 0%, 
      rgba(0,0,0,0.2) 25%, 
      rgba(0,0,0,0.4) 50%, 
      rgba(0,0,0,0.2) 75%, 
      rgba(0,0,0,0.3) 100%);
    border-radius: 2px;
    transform-origin: left;
    animation: none;
  }

  .typewriter-word[style*="--underline-trigger"]::after {
    animation: drawUnderline 0.8s ease-out forwards;
  }

  .typewriter-word.health {
    color: #166534; /* dark green */
    border-right-color: #166534;
  }

  .typewriter-word.climate {
    color: #dc2626; /* orangish-red */
    border-right-color: #dc2626;
  }

  .typewriter-word.technology {
    color: #1e40af; /* dark blue */
    border-right-color: #1e40af;
  }

  .typewriter-word.policy {
    color: #3b82f6; /* lighter blue */
    border-right-color: #3b82f6;
  }

  @keyframes blink {
    0%, 50% { border-right-color: transparent; }
    51%, 100% { border-right-color: currentColor; }
  }

  @keyframes drawUnderline {
    0% {
      width: 0;
      transform: scaleX(0);
    }
    50% {
      transform: scaleX(1.1) scaleY(0.8);
    }
    100% {
      width: 100%;
      transform: scaleX(1) scaleY(1);
    }
  }

  /* Add a subtle wavy effect to the underline */
  .typewriter-word::before {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 100%;
    height: 2px;
    background: repeating-linear-gradient(
      90deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.1) 2px,
      rgba(0,0,0,0.1) 4px
    );
    opacity: 0;
    animation: none;
  }

  .typewriter-word[style*="--underline-trigger"]::before {
    animation: showWavyLine 0.5s ease-out 0.3s forwards;
  }

  @keyframes showWavyLine {
    0% {
      opacity: 0;
      transform: translateY(5px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<Layout title="Health Initiatives @ ARTPARK - Home">
  <!-- Hero Section with Image Collage -->
  <section class="relative flex flex-col items-center bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 pt-4 pb-8 sm:min-h-screen sm:justify-center sm:pt-0 sm:pb-0">
    
    <!-- Top Row - 2 Images (Bhaskar and Rohit) -->
    <div class="flex justify-center gap-2 sm:gap-8 mb-3 sm:mb-8 w-full px-2 sm:px-4">
      <!-- Bhaskar Speaking -->
      <div class="w-[140px] h-[100px] sm:w-[300px] sm:h-[200px] rounded-2xl overflow-hidden shadow-2xl transform rotate-2">
        <Image 
          src={bhaskarSpeaking} 
          alt="Bhaskar Speaking" 
          class="w-full h-full object-cover"
          width={300}
          height={200}
        />
      </div>
      
      <!-- Rohit PMAC -->
      <div class="w-[140px] h-[100px] sm:w-[300px] sm:h-[200px] rounded-2xl overflow-hidden shadow-2xl transform -rotate-1">
        <Image 
          src={rohitPmac} 
          alt="Rohit PMAC" 
          class="w-full h-full object-cover"
          width={300}
          height={200}
        />
      </div>
    </div>
    
    <!-- Central Text Content -->
    <div class="text-center px-2 sm:px-6 lg:px-8 max-w-5xl mx-auto mb-3 sm:mb-8">
      <h1 class="text-2xl sm:text-4xl md:text-6xl lg:text-7xl font-bold text-gray-800 dark:text-white mb-3 sm:mb-8 leading-tight">
        <span class="block sm:inline">Driving Innovations at the Intersection of </span>
        <span class="word-container block sm:inline-block mt-2 sm:mt-0">
          <span class="typewriter-word" id="typewriter-word"></span>
        </span>
      </h1>
      
      <!-- Navigation Links -->
      <div class="flex flex-row gap-3 sm:gap-4 justify-center items-center mt-4 sm:mt-12">
        <a href="/data" class="bg-blue-800 hover:bg-blue-900 text-white px-4 py-2 sm:px-8 sm:py-4 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg text-sm sm:text-base flex-1 max-w-36 sm:max-w-none sm:flex-none">
          Explore Data Catalogue
        </a>
        <a href="/toolkits" class="border-2 border-blue-800 text-blue-800 hover:bg-blue-800 hover:text-white px-4 py-2 sm:px-8 sm:py-4 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105 text-sm sm:text-base flex-1 max-w-36 sm:max-w-none sm:flex-none">
          View Technical Artefacts
        </a>
      </div>
    </div>
    
    <!-- Bottom Row - 3 Images (Harish, HM Prismh, Team) -->
    <div class="flex justify-center gap-1 sm:gap-6 w-full px-2 sm:px-4 pb-4 sm:pb-0">
      <!-- Harish Talk -->
      <div class="w-[100px] h-[80px] sm:w-[250px] sm:h-[180px] rounded-2xl overflow-hidden shadow-2xl transform rotate-3">
        <Image 
          src={harishTalk} 
          alt="Harish Talk" 
          class="w-full h-full object-cover"
          width={250}
          height={180}
        />
      </div>
      
      <!-- HM Prismh Launch -->
      <div class="w-[100px] h-[80px] sm:w-[250px] sm:h-[180px] rounded-2xl overflow-hidden shadow-2xl transform -rotate-2">
        <Image 
          src={hmPrismhLaunch} 
          alt="HM Prismh Launch" 
          class="w-full h-full object-cover"
          width={250}
          height={180}
        />
      </div>
      
      <!-- Team All Hands -->
      <div class="w-[100px] h-[80px] sm:w-[250px] sm:h-[180px] rounded-2xl overflow-hidden shadow-2xl transform rotate-1">
        <Image 
          src={teamAllHands} 
          alt="Team All Hands" 
          class="w-full h-full object-cover"
          width={250}
          height={180}
        />
      </div>
    </div>
  </section>

  <!-- ARTPARK Section -->
  <section class="py-20 bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-gray-800 dark:to-gray-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
          About <span class="text-blue-600 dark:text-blue-400">ARTPARK</span>
        </h2>
        <div class="max-w-4xl mx-auto">
          <p class="text-lg text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">
            <a href="https://artpark.in" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-semibold underline">ARTPARK @ IISc</a> (AI & Robotics Technology Park) fosters innovations in AI & Robotics by bringing together the best of research, startup, industry, and government ecosystems.
          </p>
          <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
            We drive mission-oriented deep-tech projects, technology business incubation, and translational research in areas such as industrial automation, mobility, agriculture, healthcare and education.
          </p>
          <p class="text-base text-gray-500 dark:text-gray-400 mb-12 leading-relaxed">
            ARTPARK is seed-funded by the Department of Science & Technology (DST), Govt. of India, under the National Mission on Interdisciplinary Cyber-Physical Systems (NM-ICPS) and the Govt. of Karnataka.
          </p>
        </div>
      </div>

      <!-- Health Team Focus Areas -->
      <div class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-lg">
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-12 text-center max-w-3xl mx-auto">
          The Health Team at ARTPARK focuses on improving data and AI driven population health systems through the following arms:
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Research Translation -->
          <div class="text-center group">
            <div class="bg-gradient-to-br from-purple-100 to-purple-200 dark:from-purple-900 dark:to-purple-800 w-20 h-20 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-10 h-10 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Support Research Translation</h4>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
              Through our various collaborations with academia and government, we work to build the data and model infrastructure to enable translation into real-world applications.
            </p>
          </div>

          <!-- Innovation Enablement -->
          <div class="text-center group">
            <div class="bg-gradient-to-br from-green-100 to-green-200 dark:from-green-900 dark:to-green-800 w-20 h-20 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-10 h-10 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Enable Innovations</h4>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
              Through supporting the development of new models in-house as proof-of-concepts, or building innovative modeling approaches and data systems.
            </p>
          </div>

          <!-- Community of Practice -->
          <div class="text-center group">
            <div class="bg-gradient-to-br from-orange-100 to-orange-200 dark:from-orange-900 dark:to-orange-800 w-20 h-20 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-10 h-10 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Community of Practice</h4>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
              Support a community of practice in AI and data driven public health by making our datasets and systems available, and building our technical artifacts open source.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Data & Technical Artefacts Section -->
  <section class="py-20 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
          <span class="text-primary-600 dark:text-primary-400">Resources</span>
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Access our comprehensive data catalogue and powerful technical artifacts to accelerate your research and innovation.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        <!-- Data Catalogue Card -->
        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-gray-800 dark:to-gray-700 rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
          <div class="flex items-center mb-6">
            <div class="bg-blue-100 dark:bg-blue-900 p-3 rounded-xl mr-4">
              <svg class="w-8 h-8 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Data Catalogue</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">
            Browse our curated collection of datasets that we've collated and standardized for health research and innovation. 
            Access public and restricted datasets across various categories including epidemiology, climate, and public health.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
              Epidemiology
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
              Climate Data
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
              Public Health
            </span>
          </div>
          <a href="/data" class="inline-flex items-center text-blue-600 dark:text-blue-400 font-semibold hover:text-blue-700 dark:hover:text-blue-300 transition-colors">
            Explore Data Catalogue
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Technical Artefacts Card -->
        <div class="bg-gradient-to-br from-green-50 to-emerald-50 dark:from-gray-800 dark:to-gray-700 rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
          <div class="flex items-center mb-6">
            <div class="bg-green-100 dark:bg-green-900 p-3 rounded-xl mr-4">
              <svg class="w-8 h-8 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Technical Artefacts</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">
            Discover our collection of powerful development tools, modeling frameworks, and technical artifacts. 
            Built and collated to enable community access and foster scientific reproducibility and innovation.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
              Modeling Tools
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
              Data Engineering
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
              Frameworks
            </span>
          </div>
          <a href="/toolkits" class="inline-flex items-center text-green-600 dark:text-green-400 font-semibold hover:text-green-700 dark:hover:text-green-300 transition-colors">
            View Technical Artefacts
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Team Section -->
      <div class="mt-16 text-center">
        <div class="bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-700 rounded-2xl p-8">
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Meet Our Team</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-6 max-w-2xl mx-auto">
            Our diverse team of researchers, engineers, and policy experts work together to drive innovations 
            at the intersection of One Health, Climate, Technology, and Policy.
          </p>
          <a href="/team" class="inline-flex items-center bg-gray-800 hover:bg-gray-900 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg">
            Meet Our Team
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const words = [
    { text: 'One Health', class: 'health' },
    { text: 'Climate', class: 'climate' },
    { text: 'Technology', class: 'technology' },
    { text: 'Policy', class: 'policy' }
  ];
  
  let currentWordIndex = 0;
  let currentCharIndex = 0;
  let isDeleting = false;
  const typewriterElement = document.getElementById('typewriter-word');

  function typeWriter() {
    if (!typewriterElement) return; // Exit if element not found
    
    const currentWord = words[currentWordIndex];
    
    // Set the color class
    typewriterElement.className = `typewriter-word ${currentWord.class}`;
    
    if (isDeleting) {
      // Delete characters
      typewriterElement.textContent = currentWord.text.substring(0, currentCharIndex - 1);
      currentCharIndex--;
    } else {
      // Type characters
      typewriterElement.textContent = currentWord.text.substring(0, currentCharIndex + 1);
      currentCharIndex++;
    }

    let typeSpeed = isDeleting ? 50 : 100; // Faster when deleting

    if (!isDeleting && currentCharIndex === currentWord.text.length) {
      // Word is complete, trigger underline animation
      typewriterElement.style.setProperty('--underline-trigger', '1');
      
      typeSpeed = 2000;
      isDeleting = true;
    } else if (isDeleting && currentCharIndex === 0) {
      // Word is deleted, reset underline and move to next word
      typewriterElement.style.removeProperty('--underline-trigger');
      
      isDeleting = false;
      currentWordIndex = (currentWordIndex + 1) % words.length;
      typeSpeed = 500; // Pause before typing next word
    }

    setTimeout(typeWriter, typeSpeed);
  }

  // Start the typewriter effect
  typeWriter();
</script>