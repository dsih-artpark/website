---
import Layout from '../layouts/Layout.astro';
import { getProjectsWithImages } from '../utils/projects';
import { Image } from 'astro:assets';

// Get all projects with optimized images
const projects = await getProjectsWithImages();
---

<Layout title="Our Projects - Health Initiatives @ ARTPARK" description="Explore the innovative projects and solutions created by Health Initiatives @ ARTPARK">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary-50 to-blue-50 dark:from-gray-900 dark:to-gray-800 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
          Our <span class="text-primary-600 dark:text-primary-400">Projects</span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          We build and implement data-driven solutions to wicked problems at the intersection of public health and policy, and we collaborate with a wide range of partners across academia, government, policy, and industry.
        </p>
      </div>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="py-20 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
        {projects.map((project) => (
          <a 
            href={`/projects/${project.slug}`}
            class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col h-full group cursor-pointer"
          >
            <div class="relative">
              {project.optimizedImage ? (
                <Image 
                  src={project.optimizedImage} 
                  alt={project.data.title}
                  width={400}
                  height={200}
                  class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-48 bg-gray-200 dark:bg-gray-700 flex items-center justify-center">
                  <span class="text-gray-500 dark:text-gray-400 text-sm">No image available</span>
                </div>
              )}
            </div>
            
            <div class="p-6 flex flex-col flex-grow">
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {project.data.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-300 text-sm flex-grow">
                {project.data.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gray-50 dark:bg-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Have a Project in Mind?
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
        Let's collaborate and bring your ideas to life. We're always excited to work on new and challenging projects.
      </p>
      <a href="mailto:projects@dsih-team.com" class="bg-primary-600 hover:bg-primary-700 text-white px-8 py-3 rounded-lg font-medium transition-colors">
        Start a Project
      </a>
    </div>
  </section>
</Layout>